# Скопируй в .env и заполни.  cp .env.example .env

# --- LLM-провайдер (анализ хуков + генерация сценариев) ---
# claude | groq | gemini | openrouter | ollama
LLM_PROVIDER=groq

# Бесплатные варианты — нужен только ключ соответствующего сервиса:
GROQ_API_KEY=                 # console.groq.com (бесплатно, без карты)  ← дефолт
GEMINI_API_KEY=               # aistudio.google.com
OPENROUTER_API_KEY=           # openrouter.ai (есть модели :free)
# Ollama (локально) ключ не нужен — поставь LLM_PROVIDER=ollama и запусти `ollama serve`

# Необязательные переопределения (если пусто — берётся пресет провайдера):
LLM_MODEL=                    # напр. llama-3.3-70b-versatile / gemini-2.0-flash
LLM_BASE_URL=
LLM_API_KEY=                  # единый ключ, перебивает GROQ_/GEMINI_/...

# --- Claude (нужен только при LLM_PROVIDER=claude) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8

# --- Где что лежит ---
DATA_DIR=./data
# Папка с твоими b-roll клипами (фон для сгенерированных видео).
# Если пусто — будет использован обрезанный исходник (с оговоркой про авторские права).
BROLL_DIR=./assets/broll

# --- Озвучка ---
# Движок: edge (нейроголоса Microsoft, нужна сеть) или piper (офлайн-нейросеть).
TTS_ENGINE=edge
# Для edge — список голосов: edge-tts --list-voices
TTS_VOICE=ru-RU-DmitryNeural
# Для piper — путь к скачанной модели .onnx (см. README, раздел про озвучку).
PIPER_MODEL=

# --- Реклама ---
# Текст call-to-action, который накладывается на видео.
AD_TEXT=Скидка 20% по промокоду LENYA
# Либо путь к готовому рекламному клипу, который вклеивается в конец (необязательно).
AD_CLIP=

# --- Транскрипция (faster-whisper) ---
# tiny / base / small / medium / large-v3.  Чем больше — тем точнее и медленнее.
WHISPER_MODEL=base

# --- Загрузка на YouTube (опционально) ---
# Путь к client_secret.json из Google Cloud Console (OAuth Desktop App).
YOUTUBE_CLIENT_SECRET=./client_secret.json

# --- Загрузка в TikTok (опционально, нужен одобренный Content Posting API) ---
TIKTOK_ACCESS_TOKEN=

# --- Загрузка в Instagram (опционально, нужен Graph API / бизнес-аккаунт) ---
IG_ACCESS_TOKEN=
IG_USER_ID=
