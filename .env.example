# Скопируй в .env и заполни.  cp .env.example .env

# --- Обязательно: ключ Claude (анализ хуков + генерация сценариев) ---
ANTHROPIC_API_KEY=sk-ant-...

# Модель Claude (по умолчанию самая способная)
CLAUDE_MODEL=claude-opus-4-8

# --- Где что лежит ---
DATA_DIR=./data
# Папка с твоими b-roll клипами (фон для сгенерированных видео).
# Если пусто — будет использован обрезанный исходник (с оговоркой про авторские права).
BROLL_DIR=./assets/broll

# --- Озвучка ---
# Список голосов: edge-tts --list-voices
TTS_VOICE=ru-RU-DmitryNeural

# --- Реклама ---
# Текст call-to-action, который накладывается на видео.
AD_TEXT=Скидка 20% по промокоду LENYA
# Либо путь к готовому рекламному клипу, который вклеивается в конец (необязательно).
AD_CLIP=

# --- Транскрипция (faster-whisper) ---
# tiny / base / small / medium / large-v3.  Чем больше — тем точнее и медленнее.
WHISPER_MODEL=base

# --- Загрузка на YouTube (опционально) ---
# Путь к client_secret.json из Google Cloud Console (OAuth Desktop App).
YOUTUBE_CLIENT_SECRET=./client_secret.json

# --- Загрузка в TikTok (опционально, нужен одобренный Content Posting API) ---
TIKTOK_ACCESS_TOKEN=

# --- Загрузка в Instagram (опционально, нужен Graph API / бизнес-аккаунт) ---
IG_ACCESS_TOKEN=
IG_USER_ID=
